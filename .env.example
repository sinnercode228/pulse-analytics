# Server (server/src/config.ts)
PORT=8787
HOST=0.0.0.0
DATABASE_PATH=./data/pulse.db
# Enables POST /api/admin/* (create sites & monitors). Empty = disabled.
ADMIN_TOKEN=
# Comma-separated dashboard origins, or *
CORS_ORIGIN=*
# inline = checker runs in the API process; off = run `npm run worker:uptime` separately
UPTIME_MODE=inline
FLUSH_INTERVAL_MS=2000
# Serve a built dashboard from this directory (optional)
STATIC_DIR=
LOG_LEVEL=info

# Dashboard (web, Vite build-time)
# demo = synthetic data in a Web Worker (GitHub Pages); api = talk to the server
VITE_DATA_SOURCE=demo
VITE_API_URL=
