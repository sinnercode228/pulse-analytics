{
  "name": "pulse-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-friendly real-time web analytics and uptime monitoring: Fastify ingestion, rollups, WebSocket live feed, React dashboard.",
  "license": "MIT",
  "author": "sinnercode228",
  "workspaces": [
    "packages/*",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run dev -w @pulse/web",
    "dev:api": "npm run dev -w @pulse/server",
    "build": "npm run build -w @pulse/server && npm run build -w @pulse/web",
    "build:pages": "npm run build -w @pulse/web",
    "preview": "npm run preview -w @pulse/web",
    "seed": "npm run seed -w @pulse/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
